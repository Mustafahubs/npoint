#!/usr/bin/env bash
set -euo pipefail

DB_HOST="${PGHOST:-db}"
DB_PORT="${PGPORT:-5432}"

echo "Waiting for Postgres at ${DB_HOST}:${DB_PORT}..."
until bash -c "echo > /dev/tcp/${DB_HOST}/${DB_PORT}" 2>/dev/null; do
  sleep 1
done
echo "Postgres is up."

# Idempotent: creates the db and loads the schema on first run, applies any
# pending migrations on subsequent runs.
bin/rails db:prepare

exec "$@"
